{
  "name": "helix-core",
  "private": true,
  "version": "3.0.0",
  "description": "Helix Core — an open-source desktop platform for computational drug discovery",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "package": "vite build && electron-builder --config electron-builder.yml",
    "package:win": "vite build && electron-builder --win --config electron-builder.yml",
    "package:linux": "vite build && electron-builder --linux --config electron-builder.yml",
    "test:e2e": "npx playwright test --config playwright.config.ts"
  },
  "dependencies": {
    "@types/d3": "^7.4.3",
    "d3": "^7.9.0",
    "molstar": "^5.6.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "author": {
    "name": "Amr M. Alhfnawy",
    "email": "AAlhfnawy@nu.edu.eg"
  },
  "homepage": "https://github.com/amrmohamed99/HelixCore",
