    family-names: "Alhfnawy"
    email: "AAlhfnawy@nu.edu.eg"
    affiliation: "Nile University"
version: "3.0.0"
date-released: 2026-07-28
license: MIT
repository-code: "https://github.com/amrmohamed99/HelixCore-public"
keywords:
  - drug discovery
  - molecular docking
  - cheminformatics
  - virtual screening
  - AutoDock Vina
  - RDKit
  - ADMET
